    "views": [
      {
        "id": "orden",
        "label": "El slice",
        "focus": ["caller", "playtester"],
        "note": "Quien llama entrega los criterios. El playtester no pide permiso para empezar."
      },
      {
        "id": "escenario",
        "label": "Qué se escribe",
        "focus": ["playtester", "agent"],
        "note": "Solo el flow. La escena res://debug ya la armó el developer."
      },
      {
        "id": "corrida",
        "label": "La partida",
        "focus": ["playtester", "godot", "caller"],
        "note": "cli.sh flow en ventana. press es la acción del InputMap. El informe vuelve a quien llamó."
      }
    ]
  },
  "participants": [
    { "id": "caller", "type": "external", "label": "Quien llama", "sublabel": "tech lead" },
    { "id": "playtester", "type": "frontend", "label": "studio-playtester", "sublabel": "solo el slice" },
    { "id": "agent", "type": "database", "label": "res://agent/", "sublabel": "flows y out" },
    { "id": "godot", "type": "backend", "label": "Godot", "sublabel": "AgentKit CLI" }
  ],
  "segments": [
    { "from": 150, "to": 310, "label": "Pedido" },
    { "from": 330, "to": 490, "label": "Escenario" },
    { "from": 510, "to": 800, "label": "Corrida" }
  ],
  "messages": [
    { "from": "caller", "to": "playtester", "y": 190, "label": "criterios del slice", "variant": "emphasis" },
    { "from": "playtester", "to": "godot", "y": 240, "label": "inspect --unique e info", "variant": "default" },
    { "from": "godot", "to": "playtester", "y": 285, "label": "%nombres e InputMap", "variant": "return" },
    { "from": "playtester", "to": "agent", "y": 400, "label": "flow JSON hacia res://debug", "variant": "emphasis" },
    { "from": "playtester", "to": "godot", "y": 520, "label": "cli.sh flow --fail-on-error", "variant": "emphasis" },
    { "from": "playtester", "to": "godot", "y": 610, "label": "press de la acción mapeada", "variant": "emphasis" },
    { "from": "godot", "to": "agent", "y": 640, "label": "PNG en out/", "variant": "default" },
    { "from": "godot", "to": "playtester", "y": 690, "label": "AGENT_OK o AGENT_FAIL", "variant": "return" },
    { "from": "playtester", "to": "caller", "y": 745, "label": "informe PASS / FAIL", "variant": "return" }
  ],
  "activations": [
    { "participant": "playtester", "from": 184, "to": 760, "type": "frontend" },
    { "participant": "godot", "from": 234, "to": 710, "type": "backend" },
    { "participant": "agent", "from": 364, "to": 660, "type": "database" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "res://agent/",
      "items": [
        "flows/*.json apunta a res://debug o a la escena del jugador",
        "El playtester no crea esa escena ni usa call() para armarla",
        "out/ guarda los PNG. El harness no dispara ni mueve"
      ]
    },
    {
      "dot": "emerald",
      "title": "La acción",
      "items": [
        "press manda un InputEventAction de la acción mapeada",
        "_unhandled_input con is_action_pressed(acción) es el camino correcto",
        "Un keycode que no está en el InputMap es un bug del producto"
      ]
    },
    {
      "dot": "orange",
      "title": "Qué puede devolver",
      "items": [
        "NEED_SETUP: no hay res://debug en el F n. Quien llama completa el plan",
        "CACHE_STALE: un --import no registró el class_name. Quien llama lo resuelve",
        "El informe nombra cada criterio con PNG, AGENT_PRINT y la consola"
      ]
    }
  ]
}
